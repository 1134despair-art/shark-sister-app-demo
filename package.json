    "vue": "^3.4.21",
    "vue-i18n": "9.1.9"
  },
  "devDependencies": {
    "@dcloudio/types": "^3.4.8",
    "@dcloudio/uni-automator": "3.0.0-5020320260806002",
    "@dcloudio/uni-cli-shared": "3.0.0-5020320260806002",
    "@dcloudio/uni-stacktracey": "3.0.0-5020320260806002",
    "@dcloudio/vite-plugin-uni": "3.0.0-5020320260806002",
    "@vue/tsconfig": "^0.1.3",
    "@vue/runtime-core": "^3.4.21",
    "@playwright/test": "1.54.2",
